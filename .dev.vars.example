# Copy to .dev.vars for local development with the Workers runtime. Never commit .dev.vars.
# Selects which Next.js .env files are loaded locally (OpenNext). Defaults to "production" when unset.
NEXTJS_ENV=development

# Supabase spike only. Add real disposable project values to .dev.vars (never commit that file).
