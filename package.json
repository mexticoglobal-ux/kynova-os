{
  "name": "kynova-os",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "build:worker": "opennextjs-cloudflare build --env preview",
    "preview": "opennextjs-cloudflare build --env preview && opennextjs-cloudflare preview --env preview",
    "deploy": "opennextjs-cloudflare build --env preview && opennextjs-cloudflare deploy --env preview",
    "upload": "opennextjs-cloudflare build --env preview && opennextjs-cloudflare upload --env preview",
    "deploy:production": "node -e \"if (process.env.KYNOVA_CONFIRM_PRODUCTION !== 'kynova-os') { console.error('Production deploy blocked: set KYNOVA_CONFIRM_PRODUCTION=kynova-os only after explicit approval (AGENTS.md 7.11).'); process.exit(1); }\" && opennextjs-cloudflare build --env production && opennextjs-cloudflare deploy --env production",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "test:e2e": "playwright test --pass-with-no-tests",
    "test:e2e:install": "playwright install --with-deps chromium",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.13",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.0",
    "lucide-react": "^0.453.0",
    "next": "^15.5.28",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "^1.49.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.28",
    "eslint-config-prettier": "^10.0.1",
    "jsdom": "^26.0.0",
    "postcss": "^8.4.47",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.0",
    "wrangler": "^4.152.0"
  }
}
